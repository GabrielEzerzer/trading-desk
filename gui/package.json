{
  "name": "trading-desk-gui",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "engine": "cargo build --release -p td-server --bin td-server --manifest-path ../Cargo.toml",
    "dev": "pnpm engine && pnpm --filter @td/app dev",
    "dev:hush": "pnpm engine && hush run -- pnpm --filter @td/app dev",
    "build": "pnpm --filter @td/app build",
    "dist": "pnpm engine && pnpm build && pnpm --filter @td/app dist",
    "install-check": "node scripts/install-check.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
